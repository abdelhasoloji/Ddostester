{
  "uid": "shieldtest-http-receipts",
  "title": "Private lab · HTTP target receipts",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": ["shieldtest", "private-lab", "received-evidence"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Recorded requests by campaign / run",
      "description": "Actual tagged HTTP receipts at the dedicated target. Absent buckets remain unknown. Not an entry-protection measurement.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "shieldtest_http_target_received_requests_total",
          "legendFormat": "{{campaign_id}} / {{run_id}} · {{pod_uid}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Collector continuity",
      "description": "1 means the receipt collector currently reports no observed continuity gap; it is not a campaign or protection verdict.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "shieldtest_http_target_collector_complete",
          "legendFormat": "{{pod_uid}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Receipt log availability",
      "description": "0 indicates a missing/unreadable log. Scrape success alone does not establish valid receipt collection.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "shieldtest_http_target_log_available",
          "legendFormat": "{{pod_uid}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Age of last successful log read",
      "description": "Based on source read time, not the instant-query evaluation timestamp. Missing samples remain unknown.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "time() - shieldtest_http_target_last_collection_timestamp_seconds",
          "legendFormat": "{{pod_uid}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
