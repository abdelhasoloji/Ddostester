{
  "uid": "shieldtest-lab",
  "title": "WEDOS ShieldTest — Network Lab",
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "BAP (byte amplification)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "shieldtest_reflector_bap", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Packet amplification",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "shieldtest_reflector_packet_amplification", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Mitigating",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "no" }, "1": { "text": "yes" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [{ "expr": "shieldtest_scrubber_mitigating", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Detection delay (s)",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "shieldtest_scrubber_detection_delay_seconds", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Target throughput (bits/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "shieldtest_target_avg_bps", "legendFormat": "target bps", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Scrubber: forwarded vs dropped",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "shieldtest_scrubber_forwarded_total",
          "legendFormat": "forwarded",
          "refId": "A"
        },
        { "expr": "shieldtest_scrubber_dropped_total", "legendFormat": "dropped", "refId": "B" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Collateral (% of drops that were legitimate)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [{ "expr": "shieldtest_scrubber_collateral_pct", "refId": "A" }]
    }
  ]
}
