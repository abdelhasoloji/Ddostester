{
  "name": "@ddostester/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build-info.mjs",
    "start": "node dist/server.js",
    "slogate": "node dist/cli/slogate.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.4",
    "fastify": "^5.12.5",
    "pg": "^8.13.1",
    "undici": "^8.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^3.2.7",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
