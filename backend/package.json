{
  "name": "@ddostester/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build-info.mjs",
    "start": "node dist/server.js",
    "slogate": "node dist/cli/slogate.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "hash-password": "node scripts/hash-password.mjs",
    "test:postgres": "vitest run test/fleet-missions.test.ts test/store-contract.test.ts test/postgres-guarantees.test.ts test/fleet-postgres.test.ts test/drs-monitoring-postgres.test.ts test/owner-recovery.test.ts test/assistant-token-budget.test.ts --maxWorkers=1"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7",
    "pg": "^8.13.1",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "4.1.12",
    "fast-check": "^4.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "4.1.12"
  }
}
