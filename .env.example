# Backend
PORT=8080
# Adresse d'écoute. Laisser 127.0.0.1 : accès distant via tunnel SSH, jamais
# d'exposition publique (l'outil n'a pas d'authentification).
HOST=127.0.0.1
# Liste blanche des hôtes autorisés (séparés par des virgules).
# Le moteur REFUSE toute cible absente de cette liste. Ne mets ici que
# des systèmes qui t'appartiennent ou pour lesquels tu as une autorisation écrite.
ALLOWED_TARGETS=localhost,127.0.0.1

# Persistance PostgreSQL. Si absent, l'API utilise un stockage en mémoire
# (perdu au redémarrage). Format : postgresql://user:pass@host:5432/dbname
# DATABASE_URL=postgresql://shieldtest:motdepasse@127.0.0.1:5432/shieldtest

# Auth + RBAC. Si AUTH_JWT_SECRET est absent, l'auth est DÉSACTIVÉE (mode dev).
# AUTH_JWT_SECRET=<chaine-longue-aleatoire>
# Utilisateurs (JSON). Générer un hash : npm run hash-password -w backend -- <motdepasse>
# Rôles : engineer (crée/exécute), officer (approuve), viewer (lecture+kill).
# AUTH_USERS=[{"email":"off@wedos","role":"officer","passwordHash":"scrypt$..."}]
