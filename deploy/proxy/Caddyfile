# TLS (+ optional mTLS) reverse proxy in front of the ShieldTest control plane.
# Terminates TLS and forwards to the API (internal Docker loopback: api:8080).
# The TSD calls for "HTTPS + mTLS"; this proxy provides that termination.

{$SHIELDTEST_DOMAIN:shieldtest.internal} {
	# TLS: self-signed internal certificate by default (this is an internal tool).
	# For real certificates, replace with `tls email@wedos` (ACME) or `tls cert key`.
	tls internal {
		# --- mTLS (client-certificate authentication) -------------------------
		# Uncomment to REQUIRE a client certificate signed by the WEDOS internal
		# CA. Mount the CA into the container (see docker-compose, proxy profile).
		# client_auth {
		#	mode require_and_verify
		#	trusted_ca_cert_file /etc/caddy/ca.crt
		# }
	}

	encode gzip
	reverse_proxy api:8080
}
