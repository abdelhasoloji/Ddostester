{
  "name": "@ddostester/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "@types/pg": "^8.11.10"
  }
}
