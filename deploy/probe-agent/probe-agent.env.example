# WEDOS ShieldTest probe agent (VPS2) — copy to /etc/probe-agent.env and edit.
# Bearer token the control plane (VPS1) must present. Generate a strong one:
#   openssl rand -hex 32
PROBE_AGENT_TOKEN=CHANGE_ME_openssl_rand_hex_32

# Comma-separated hostnames the agent may GET (the authorized probe targets).
PROBE_AGENT_ALLOWLIST=portal.preprod.cra-srp-pp.enisa.europa.eu

# Bind to the TAILNET address so the agent is only reachable over the tailnet
# (never public). Get it with:  tailscale ip -4
PROBE_AGENT_BIND=100.x.y.z
PROBE_AGENT_PORT=8099

# Safety bounds (defaults shown).
PROBE_AGENT_MAX_TIMEOUT_MS=15000
PROBE_AGENT_RATE_PER_SEC=20
PROBE_AGENT_MAX_IN_FLIGHT=2
PROBE_AGENT_MAX_BODY_SLICE=20000
