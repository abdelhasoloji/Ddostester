# Site worker inputs. Copy to site.env (git-ignored) and fill in.
#
#   cp site.env.example site.env      # then edit
#   set -a; . ./site.env; set +a
#   envsubst < worker.template.yaml | kubectl apply -f -

# Namespace on the remote cluster. May equal ddostester-lab; the worker itself
# needs no RBAC and creates no Jobs.
SITE_NAMESPACE=ddostester-ac02

# WireGuard example: coordinator 10.8.0.1, site 10.8.0.2.
# The host in this URL must appear in the coordinator certificate SAN — as
# IP:10.8.0.1 for an IP URL, or DNS:<name> for a hostname URL.
FLEET_CONTROL_URL=https://10.8.0.1:8443

# Agent identity at this site; must match the certificate CN and the
# `FLEET_SITES` entry on the coordinator (e.g. three@ac02).
FLEET_AGENT_ID=three
FLEET_IDENTITY_SECRET=fleet-three

# Label only — the worker never reads it. It exists so check-render.mjs can tell
# you exactly which FLEET_SITES entry the coordinator needs (agent@site). The
# site is NOT a worker env var: it lives in the coordinator's registry.
SITE_NAME=ac02

# Digest, never a mutable tag. Produced by the docker/ghcr commands in README.md.
FLEET_WORKER_IMAGE=ghcr.io/CHANGE_ME/ddostester-lab-control@sha256:CHANGE_ME

FLEET_POLL_MS=1000

# Egress target for the NetworkPolicy.
COORDINATOR_CIDR=10.8.0.1/32
COORDINATOR_PORT=8443

# The site's own policy: hosts and ports it is willing to emit traffic to, and
# caps it will never exceed. Keep at or below the coordinator's fleet envelope.
TARGET_HOST=lab-target
TARGET_PORT=8080
CAP_RPS=15
CAP_CONCURRENCY=6
CAP_DURATION=60

# Pod resources.
WORKER_CPU_REQUEST=100m
WORKER_CPU_LIMIT=500m
WORKER_MEM_REQUEST=128Mi
WORKER_MEM_LIMIT=256Mi
