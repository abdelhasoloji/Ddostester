# Backend
# DRS-only catalogue and Fleet campaign creation. Legacy is for regression testing only.
CAMPAIGN_CATALOG=drs-fleet
PORT=8080
# Listen address. Keep 127.0.0.1: remote access via SSH tunnel, never expose
# publicly (the tool has no authentication when AUTH_JWT_SECRET is unset).
HOST=127.0.0.1
# CORS: same-origin by default (the UI is served by this server). Set only if
# the UI is hosted on a different origin (comma-separated).
# CORS_ORIGIN=https://ui.internal
# Data retention: prune runs/audit/WRS samples older than N days (0 disables).
# RETENTION_DAYS=90
# Max campaigns running at once (safety guard against target/host contention).
# MAX_CONCURRENT_RUNS=3
# Allowlist of authorized hosts (comma-separated).
# The generator REFUSES any target outside this list. Only add systems you
# own or hold written authorization to test.
ALLOWED_TARGETS=localhost,127.0.0.1

# Isolated lab targets for DRS-validation records (docs/drs-engine.md).
# MUST NOT overlap ALLOWED_TARGETS — the server fails to start if they do.
# Empty = DRS validation disabled. These are lab-only hosts with no route to prod.
# LAB_TARGETS=lab-target.internal
# Independently approved HTTP origins for persistent Fleet campaigns.
# Must also be in the effective application allowlist AND worker/network policy.
# FLEET_CAMPAIGN_ORIGINS=http://lab-target:8080

# Governed class-C network-bench dispatch (docs/cross-repo-contract.md).
# Bearer token the ISOLATED shieldtest-lab runner presents to claim/complete
# bench runs. The control plane records a CISO-authorized run and serves it to the
# runner; it NEVER emits amplification traffic itself. Empty = dispatch disabled
# (fail-closed). Requires a LAB_TARGETS host too.
# BENCH_RUNNER_TOKEN=change-me-a-long-random-secret

# Internal HTTPS targets — TLS trust.
# Preferred: trust your internal CA (verification stays ON, all engines):
# NODE_EXTRA_CA_CERTS=/etc/ssl/wedos-internal-ca.pem
# Escape hatch for self-signed targets in an ISOLATED lab only: disables TLS
# certificate verification for ALL outbound requests of this process. Surfaced
# in /health and the Settings page. Never enable outside a closed lab.
# INSECURE_TLS=false

# PostgreSQL persistence. If unset, the API uses in-memory storage
# (lost on restart). Format: postgresql://user:pass@host:5432/dbname
# DATABASE_URL=postgresql://shieldtest:password@127.0.0.1:5432/shieldtest

# Auth + RBAC. If AUTH_JWT_SECRET is unset, auth is DISABLED (dev mode).
# AUTH_JWT_SECRET=<long-random-string>
# Users (JSON). Generate a hash: npm run hash-password -w backend -- <password>
# Roles/capabilities: see docs/single-user.md. Only the sole admin manages limits.
# AUTH_USERS=[{"email":"off@wedos","role":"officer","passwordHash":"scrypt$..."}]

# Load engine: builtin (integrated, default) | k6 | vegeta | locust | jmeter |
# gatling (the last five delegate to the corresponding external tool, which must
# be installed on the host). See scripts/conformance/README.md
# AGENT=builtin
# Gatling 3.16.0 Maven bundle: explicit home, offline dependency cache and Java required.
# GATLING_HOME=/absolute/path/gatling-charts-highcharts-bundle-3.16.0
# JAVA_HOME=/absolute/path/to/private/jdk
# GATLING_BIN remains the legacy launcher integration when GATLING_HOME is unset.

# Notifications (optional, opt-in). The control plane pushes a message when a
# campaign completes, a run is killed, or a target's WRS regresses. Configure a
# Slack incoming webhook and/or a generic JSON webhook. See docs/observability.md
# NOTIFY_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# NOTIFY_WEBHOOK_URL=https://example.internal/shieldtest-hook
# Restrict which events are sent (comma-separated). Default: all.
# NOTIFY_EVENTS=campaign.completed,campaign.killed,wrs.regression,baseline.drift

# Protection integration (optional). Endpoint queried at the end of a run for
# the REAL detection/mitigation timings from your WAF / scrubbing / cloud DDoS
# protection. When set and it returns {"detectionTimeSec":n,"mitigationTimeSec":n},
# the WRS is computed from measured values instead of estimates. Inbound
# measurement only — it generates no traffic. See docs/measurement.md.
#
# Two pluggable connectors (webhook takes precedence when both are set):
#   - Push: we POST the run window; the endpoint replies with the timings.
# PROTECTION_WEBHOOK_URL=https://protection.internal/shieldtest-timings
#   - Pull: we GET a metrics endpoint (run window passed as query params
#     campaignId/target/from/to) that returns the same JSON shape.
# PROTECTION_METRICS_URL=https://protection.internal/metrics
#   Built-in lab-scrubber adapter: point the pull connector at the control
#   plane's own endpoint to surface the latest class-C lab verdict's
#   detection/mitigation timing (source `wedos-lab-scrubber`; 404 → fall back to
#   the estimate). Useful until the real WEDOS scrubber endpoint is wired.
# PROTECTION_METRICS_URL=http://127.0.0.1:8080/api/protection/lab-metrics
# Provenance label stamped on a measurement that carries no source of its own
# (shown on the run so measured vs mock is always explicit).
# PROTECTION_SOURCE_LABEL=scrubbing
# PROTECTION_TIMEOUT_MS=5000
# Lab/demo: exercise the measured-WRS path without a live source. Returns fixed
# timings tagged source "mock" (shown as such on the run — never real data).
# PROTECTION_MOCK=false
# PROTECTION_MOCK_DETECTION_SEC=15
# PROTECTION_MOCK_MITIGATION_SEC=45

# Target host telemetry (optional, EPIC B1). During a run the control plane GETs
# this metrics endpoint once a second (query params campaignId/target) and
# correlates the host counters to the run timeline. Inbound measurement only —
# it generates no traffic. The endpoint returns any of:
#   {"cpuPct":n,"conntrack":n,"nicRxMbps":n,"nicTxMbps":n}
# TARGET_TELEMETRY_METRICS_URL=https://lab.internal/node-metrics
# TARGET_TELEMETRY_TIMEOUT_MS=3000
# Lab/demo: fixed sample so the correlation path can be exercised with no source.
# TARGET_TELEMETRY_MOCK=false
# TARGET_TELEMETRY_MOCK_CPU_PCT=40
# TARGET_TELEMETRY_MOCK_CONNTRACK=1000
# TARGET_TELEMETRY_MOCK_NIC_RX_MBPS=50
# TARGET_TELEMETRY_MOCK_NIC_TX_MBPS=20

# --- Synthetic UDP network lab ---------------------------------------------
# The closed synthetic UDP-amplification lab lives in its own repository —
# https://github.com/abdelhasoloji/shieldtest-lab — and carries its own caps
# (LAB_MAX_FACTOR, LAB_MAX_PPS, scrubber thresholds, PROFILE/SHAPE, …). None of
# those variables are read by this control plane. LAB_TARGETS above is unrelated:
# it is the DRS-validation allowlist, not a lab-runtime setting.

# --- Bilateral absorption (I1): corroborate our inferred absorption with the
# target edge's own blocked/seen counts. Optional; absorption stays one-sided
# (inferred) when unset. Point EDGE_ABSORPTION_METRICS_URL at an endpoint that
# answers {seen,blocked,served[,rateLimited,source]} for a run window+tag, or use
# EDGE_ABSORPTION_MOCK=true for a lab/demo (clearly labelled 'mock').
# EDGE_ABSORPTION_METRICS_URL=https://edge.example/absorb
# EDGE_ABSORPTION_SOURCE_LABEL=scrubbing
# EDGE_ABSORPTION_MOCK=false

# --- App-native charts (option B): the app queries the same Prometheus that
# feeds Grafana (a bounded, named-series proxy at /api/metrics/range) and renders
# it with uPlot in-app. Optional; the native charts hide themselves when unset.
# Prometheus is loopback on the monitoring host, so in production point this at a
# VPS1->VPS2 tunnel (ssh -L 127.0.0.1:9090 -> VPS2:9090).
# PROMETHEUS_URL=http://127.0.0.1:9090

# --- Conversational Assistant (read-only Qwen copilot) ---------------------
# A text-only streaming bridge to an OpenAI-compatible endpoint (self-hosted
# Qwen via llama.cpp). Read-only: it cannot launch campaigns or run anything.
# Unset → the Assistant screen shows "not configured" (fail-soft).
# ASSISTANT_ENDPOINT=https://<pod>-8080.proxy.runpod.net/v1
# ASSISTANT_API_KEY=
# ASSISTANT_MODEL=qwen

# --- Assistant GPU pod power (RunPod stop/resume) --------------------------
# Lets operators power the Qwen GPU pod on/off from the UI to avoid GPU billing
# (assistant:manage, audited). Uses stop/resume so the pod id + proxy URL stay
# stable; when RUNPOD_POD_ID is set and ASSISTANT_ENDPOINT is not, the endpoint
# is derived from the pod's proxy URL automatically. Unset → pod is "unmanaged".
# RUNPOD_API_KEY=
# RUNPOD_POD_ID=
# RUNPOD_POD_PORT=8080

# Default single-administrator mode; set USER_MODE=team for team workflows. Requires PostgreSQL + a strong AUTH_JWT_SECRET.
# Default administrator: abdelha@wedos; override SINGLE_USER_EMAIL only to explicitly select another account.
# Other administrators become viewers; other account profiles and statuses are preserved.
USER_MODE=single
SINGLE_USER_EMAIL=abdelha@wedos
# First bootstrap ONLY through the explicit migrate-users CLI on an empty installation.
# Remove after successful migration.
# Existing credentials are preserved and this value never resets a password.
SINGLE_USER_PASSWORD=

# Explicit opt-in only for a genuinely isolated lab; required by INSECURE_TLS=true.
ISOLATED_LAB=0

# Existing registered lab agents: authenticated single-user PostgreSQL only.
# Persistent HTTP missions require an explicitly approved private or public origin.
FLEET_MISSIONS_ENABLED=0
