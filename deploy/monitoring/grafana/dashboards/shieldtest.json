{
  "uid": "shieldtest",
  "title": "WEDOS ShieldTest",
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Exécutions (total)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" } }, "overrides": [] },
      "targets": [{ "expr": "shieldtest_runs_total", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Campagnes par statut",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "targets": [{ "expr": "shieldtest_campaigns", "legendFormat": "{{status}}", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Dernier WRS par cible",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "yellow", "value": 70 },
              { "color": "green", "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [{ "expr": "shieldtest_wrs_last", "legendFormat": "{{target}}", "refId": "A" }]
    }
  ]
}
