# Reverse-proxy TLS (+ mTLS optionnel) devant le control plane ShieldTest.
# Termine TLS et transmet vers l'API (loopback interne du réseau Docker : api:8080).
# Le TSD prévoit « HTTPS + mTLS » : ce proxy en fournit la terminaison.

{$SHIELDTEST_DOMAIN:shieldtest.internal} {
	# TLS : certificat interne auto-signé par défaut (outil interne). Pour des
	# certificats réels, remplacer par `tls email@wedos` (ACME) ou `tls cert key`.
	tls internal {
		# --- mTLS (authentification par certificat client) --------------------
		# Décommenter pour EXIGER un certificat client signé par la CA interne
		# WEDOS. Monter la CA dans le conteneur (voir docker-compose, profil proxy).
		# client_auth {
		#	mode require_and_verify
		#	trusted_ca_cert_file /etc/caddy/ca.crt
		# }
	}

	encode gzip
	reverse_proxy api:8080
}
